{
  "expo": {
    "name": "stok",
    "slug": "stok",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "stok",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.elgabrielcisneros.stok"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.elgabrielcisneros.stok"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "fonts": ["./assets/fonts/Inter_18pt-Regular.ttf"],
          "android": {
            "fonts": [
              {
                "fontFamily": "Inter",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/Inter_18pt-Bold.ttf",
                    "weight": "700"
                  },
                  {
                    "path": "./assets/fonts/Inter_18pt-Italic.ttf",
                    "weight": "400",
                    "style": "italic"
                  },
                  {
                    "path": "./assets/fonts/Inter_18pt-Light.ttf",
                    "weight": "200"
                  },
                  {
                    "path": "./assets/fonts/Inter_18pt-Medium.ttf",
                    "weight": "500"
                  },
                  {
                    "path": "./assets/fonts/Inter_18pt-SemiBold.ttf",
                    "weight": "600"
                  }
                ]
              }
            ]
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
